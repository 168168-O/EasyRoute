<Window x:Class="DahuoChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DahuoChat"
        Title="达货聊天"
        Width="1280" Height="720"
        MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBg}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Grid>
    <Ellipse Width="420" Height="180" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-40,-50,0,0" IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#22E9D3A0" Offset="0"/>
          <GradientStop Color="#00E9D3A0" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <Ellipse Width="280" Height="160" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-20,-40" IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#186FB8F0" Offset="0"/>
          <GradientStop Color="#006FB8F0" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border x:Name="TitleBar" BorderBrush="#33E9D3A0" BorderThickness="0,0,0,1" Background="#CC070B12">
        <DockPanel Margin="10,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="显示不对" Style="{StaticResource GhostBtn}" Padding="8,2" Margin="0,0,8,0" Click="BadView_Click" Visibility="{Binding LiveWechat, Converter={StaticResource BoolVis}}" ToolTip="改成贴在微信旁边" WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button Content="—" Style="{StaticResource BareBtn}" Width="36" Height="28" Click="Min_Click" Foreground="{StaticResource Ink2}" WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button Content="□" Style="{StaticResource BareBtn}" Width="36" Height="28" Click="Max_Click" Foreground="{StaticResource Ink2}" WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button Content="×" Style="{StaticResource BareBtn}" Width="36" Height="28" Click="Close_Click" Foreground="{StaticResource Gold}" WindowChrome.IsHitTestVisibleInChrome="True"/>
          </StackPanel>
          <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource GoldFill}" DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center">
            <TextBlock Text="达" Foreground="#FF2A1F0C" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="达货聊天" Foreground="{StaticResource GoldText}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,12,0"/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border CornerRadius="9" BorderBrush="#44E9D3A0" BorderThickness="1" Background="#14E9D3A0" Padding="8,2" Margin="0,0,6,0">
              <TextBlock Text="{Binding TitleAccount}" Foreground="{StaticResource Gold}" FontSize="12"/>
            </Border>
            <Border CornerRadius="9" BorderBrush="#335FE0A0" BorderThickness="1" Background="#145FE0A0" Padding="8,2" Margin="0,0,6,0">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="#FF5FE0A0" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding TitleState}" Foreground="#FFB7E7C8" FontSize="12"/>
              </StackPanel>
            </Border>
            <Border CornerRadius="9" BorderBrush="#336FB8F0" BorderThickness="1" Background="#146FB8F0" Padding="8,2">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Visibility" Value="Visible"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ExtraChip}" Value="">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Text="{Binding ExtraChip}" Foreground="{StaticResource Ice}" FontSize="12"/>
            </Border>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="RailCol" Width="72"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F0080C14" BorderBrush="#22E9D3A0" BorderThickness="0,0,1,0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
              <Button Style="{StaticResource BareBtn}" Click="Settings_Click" Margin="0,4" ToolTip="话术库">
                <StackPanel>
                  <TextBlock Text="库" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource Gold}"/>
                  <TextBlock Text="话术" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource Ink3}"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource BareBtn}" Click="Settings_Click" Margin="0,4" ToolTip="设置">
                <StackPanel>
                  <TextBlock Text="设" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource Ice}"/>
                  <TextBlock Text="设置" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource Ink3}"/>
                </StackPanel>
              </Button>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Accounts}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource BareBtn}" Tag="{Binding Id}" Click="Account_Click" Margin="0,5" ToolTip="{Binding Sub}">
                      <Grid Width="56" Height="58">
                        <Border Width="44" Height="44" CornerRadius="14" VerticalAlignment="Top" HorizontalAlignment="Center">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="#FF1A2230"/>
                              <Setter Property="BorderBrush" Value="#22FFFFFF"/>
                              <Setter Property="BorderThickness" Value="1"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Platform}" Value="wechat">
                                  <Setter Property="Background" Value="#FF1F8F4E"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Selected}" Value="True">
                                  <Setter Property="BorderBrush" Value="#FFE9D3A0"/>
                                  <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <Grid>
                            <TextBlock Text="{Binding Mark}" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="☾" FontFamily="Segoe UI Symbol" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,1" Foreground="{StaticResource Ice}">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Sleeping}" Value="True">
                                      <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </Grid>
                        </Border>
                        <Border MinWidth="16" Height="16" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,2,0" Padding="4,0">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="{StaticResource GoldFill}"/>
                              <Setter Property="Visibility" Value="Visible"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IceBadge}" Value="True">
                                  <Setter Property="Background" Value="{StaticResource IceFill}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Badge}" Value="">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="Bold" Foreground="#FF1A1408" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Title}" FontSize="10" Foreground="{StaticResource Ink3}" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="8,8,4,8">
          <local:WeChatDemoView x:Name="WechatDemo"/>
          <local:DouyinDemoView x:Name="DouyinDemo" Visibility="Collapsed"/>
          <local:SlotHost x:Name="Slot" Visibility="Collapsed"/>
          <Grid x:Name="DouyinLive" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="30"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="#296FB8F0" BorderBrush="#48A9DCFF" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="12,0">
              <TextBlock Text="{Binding EnvLine}" Foreground="{StaticResource Ice}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Border>
            <Grid x:Name="DouyinMount" Grid.Row="1"/>
          </Grid>
          <Border x:Name="MissingCard" Visibility="Collapsed" CornerRadius="18" BorderBrush="#66E9D3A0" BorderThickness="1" Padding="28" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F01A2232" Offset="0"/>
                <GradientStop Color="#F2090D15" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
              <TextBlock Text="微信还没放进来" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Gold}"/>
              <TextBlock Text="{Binding LaunchHint}" TextWrapping="Wrap" Margin="0,8,0,8" Foreground="{StaticResource Ink2}" FontSize="14"/>
              <TextBlock Text="{Binding Promise}" TextWrapping="Wrap" Foreground="{StaticResource Ink3}" FontSize="12" Margin="0,0,0,14"/>
              <Button Content="打开微信" Style="{StaticResource GoldBtn}" HorizontalAlignment="Left" Height="36" Padding="18,6" Click="Launch_Click"/>
            </StackPanel>
          </Border>
        </Grid>

        <Border x:Name="PanelShell" Grid.Column="2" Width="360" ClipToBounds="True" Visibility="{Binding ShowChat, Converter={StaticResource BoolVis}}">
          <Grid>
            <local:ReplyPanel Margin="4,8,8,8" Visibility="{Binding PanelOpen, Converter={StaticResource BoolVis}}"/>
            <Button Content="«" Style="{StaticResource GhostBtn}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="28" Click="Reopen_Click" Visibility="{Binding PanelOpen, Converter={StaticResource BoolVis}, ConverterParameter=inv}"/>
          </Grid>
        </Border>

        <local:WizardView x:Name="WizardPage" Grid.Column="1" Grid.ColumnSpan="2" Visibility="{Binding ShowWizard, Converter={StaticResource BoolVis}}"/>
        <local:SettingsView x:Name="SettingsPage" Grid.Column="1" Grid.ColumnSpan="2" Visibility="{Binding ShowSettings, Converter={StaticResource BoolVis}}"/>
      </Grid>
    </Grid>
    <Border x:Name="ToastBar" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22" Visibility="Collapsed" CornerRadius="10" Background="#F2E9D3A0" Padding="16,8" Panel.ZIndex="8" IsHitTestVisible="False">
      <TextBlock x:Name="ToastText" Foreground="#FF2A1F0C" FontSize="13"/>
    </Border>
  </Grid>
</Window>
