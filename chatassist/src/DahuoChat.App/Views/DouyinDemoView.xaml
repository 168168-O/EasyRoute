<UserControl x:Class="DahuoChat.DouyinDemoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid Background="#FF161823">
    <Grid.RowDefinitions>
      <RowDefinition Height="30"/>
      <RowDefinition Height="56"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border Background="#296FB8F0" BorderBrush="#48A9DCFF" BorderThickness="0,0,0,1" Padding="14,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="与其他号不共享登录" Foreground="#FF8E9BB0" FontSize="11" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding EnvLine}" Foreground="#FFA9DCFF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
    <DockPanel Grid.Row="1" Margin="18,0">
      <TextBlock Text="抖音" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
      <Border Width="30" Height="30" CornerRadius="15" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFC79A52" Offset="0"/>
            <GradientStop Color="#FF7A5428" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Border Height="34" CornerRadius="17" Background="#FF252632" Margin="80,0,20,0" VerticalAlignment="Center">
        <TextBlock Text="搜索你感兴趣的内容" Foreground="#FF8A8B99" FontSize="12" VerticalAlignment="Center" Margin="14,0"/>
      </Border>
    </DockPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="270"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border BorderBrush="#10FFFFFF" BorderThickness="0,0,1,0">
        <StackPanel Margin="0,12,0,0">
          <TextBlock Text="私信" FontSize="14" FontWeight="SemiBold" Foreground="#FFE8E9EE" Margin="16,0,0,10"/>
          <Border Background="#FF252632" Padding="16,10">
            <DockPanel>
              <Border Width="42" Height="42" CornerRadius="21" Background="#FFA8548A" Margin="0,0,10,0">
                <TextBlock Text="雨" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
              </Border>
              <StackPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="21:08" Foreground="#FF6F7080" FontSize="11"/>
                  <TextBlock Text="林小雨" Foreground="#FFE8E9EE" FontSize="13"/>
                </DockPanel>
                <TextBlock Text="好久不见！刷到你的视频了…" Foreground="#FF8A8B99" FontSize="12" Margin="0,3,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Padding="16,10">
            <DockPanel>
              <Border Width="42" Height="42" CornerRadius="21" Background="#FF5A7FC0" Margin="0,0,10,0">
                <TextBlock Text="峰" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Fill="#FFFE2C55" VerticalAlignment="Center"/>
              <StackPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="20:40" Foreground="#FF6F7080" FontSize="11"/>
                  <TextBlock Text="阿峰在路上" Foreground="#FFE8E9EE" FontSize="13"/>
                </DockPanel>
                <TextBlock Text="哈哈这个太真实了" Foreground="#FF8A8B99" FontSize="12" Margin="0,3,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Padding="16,10">
            <DockPanel>
              <Border Width="42" Height="42" CornerRadius="21" Background="#FF4F9A83" Margin="0,0,10,0">
                <TextBlock Text="糖" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel>
                <TextBlock Text="糖糖不吃糖" Foreground="#FFE8E9EE" FontSize="13"/>
                <TextBlock Text="谢谢你的关注呀～" Foreground="#FF8A8B99" FontSize="12" Margin="0,3,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="56"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="96"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="#10FFFFFF" BorderThickness="0,0,0,1" Padding="20,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="30" Height="30" CornerRadius="15" Background="#FFA8548A" Margin="0,0,10,0">
              <TextBlock Text="雨" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="林小雨" Foreground="#FFE8E9EE" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="22,18">
          <TextBlock Text="21:06" Foreground="#FF6F7080" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,12"/>
          <Border Width="124" Height="150" CornerRadius="12" HorizontalAlignment="Left" Margin="44,0,0,12">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF3B4A6B" Offset="0"/>
                <GradientStop Color="#FF1E2433" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="▶" Foreground="#D9FFFFFF" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Border BorderBrush="#F26FB8F0" BorderThickness="2" CornerRadius="10" Padding="8" HorizontalAlignment="Left">
            <DockPanel>
              <Border Width="34" Height="34" CornerRadius="17" Background="#FFA8548A" Margin="0,0,10,0">
                <TextBlock Text="雨" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border Background="#FF2B2C38" CornerRadius="14" Padding="13,9" MaxWidth="420">
                <TextBlock Text="天哪是你吗！好久不见！刷到你的视频了，你现在在哪发展呀？" Foreground="#FFE8E9EE" FontSize="14" TextWrapping="Wrap"/>
              </Border>
            </DockPanel>
          </Border>
        </StackPanel>
        <Border Grid.Row="2" BorderBrush="#10FFFFFF" BorderThickness="0,1,0,0" Padding="20,14">
          <Grid>
            <Border Height="40" CornerRadius="10" Background="#FF252632" BorderBrush="#B36FB8F0" BorderThickness="1" Padding="14,0">
              <TextBlock Text="好久不见呀！我在深圳这边，还在慢慢打拼。你现在在哪儿发展？" Foreground="#FFE8E9EE" FontSize="13" VerticalAlignment="Center"/>
            </Border>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,8,0" CornerRadius="6" Padding="8,2" Background="{StaticResource IceFill}">
              <TextBlock Text="已填入 · 你按回车发送" Foreground="#FF06121E" FontSize="11"/>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
