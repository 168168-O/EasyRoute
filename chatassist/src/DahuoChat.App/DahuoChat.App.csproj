<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AssemblyName>dahuo-chat</AssemblyName>
    <RootNamespace>DahuoChat</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
    <Product>达货聊天</Product>
    <Company>达货</Company>
    <Description>达货聊天：只给高情商回复建议，发送永远由你自己按。</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DahuoChat.Core\DahuoChat.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\observer.js" />
    <EmbeddedResource Include="Assets\focus.js" />
  </ItemGroup>
</Project>
